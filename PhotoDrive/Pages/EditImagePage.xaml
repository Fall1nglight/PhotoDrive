<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PhotoDrive.Pages.EditImagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:PhotoDrive.ViewModels"
    Title="Edit Image"
    Loaded="ContentPage_Loaded"
    x:DataType="vm:EditImagePageViewModel">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource ContentStack}">
            <Border Style="{StaticResource SurfaceCard}">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="Title" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputCard}">
                            <Entry Text="{Binding SelectedImage.Title}" />
                        </Border>
                    </VerticalStackLayout>

                    <Border
                        Style="{StaticResource PhotoCard}"
                        HeightRequest="320"
                        HorizontalOptions="Fill">
                        <Image Source="{Binding SelectedImage.FilePath}" Aspect="AspectFit" />
                    </Border>

                    <Button
                        Text="Save"
                        Command="{Binding SaveCommand}"
                        HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
