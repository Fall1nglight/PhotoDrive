<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PhotoDrive.MainPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PhotoDrive.Model"
    xmlns:vm="clr-namespace:PhotoDrive.ViewModels"
    x:DataType="vm:MainPageViewModel">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Style="{StaticResource ContentStack}"
                Padding="24,22,24,104">
                <CollectionView
                    ItemsSource="{Binding Images}"
                    Margin="0,2,0,4">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            Orientation="Vertical"
                            Span="3"
                            HorizontalItemSpacing="14"
                            VerticalItemSpacing="14" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ImageEntity">
                            <Border
                                Style="{StaticResource PhotoCard}"
                                HeightRequest="190"
                                MaximumWidthRequest="220">
                                <ImageButton
                                    Command="{Binding BindingContext.ShowImageActionsMenuCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}"
                                    Source="{Binding FilePath}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <Button
            Text="+"
            Clicked="NavigateToAddImagePage"
            HorizontalOptions="End"
            VerticalOptions="End"
            WidthRequest="60"
            HeightRequest="60"
            Margin="24"
            Padding="0"
            CornerRadius="30"
            FontFamily="OpenSansRegular"
            FontSize="30"
            Shadow="0,6 14 #1E293B" />
    </Grid>
</ContentPage>
